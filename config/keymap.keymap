    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none             &none          &none      &none       &none     &none                                             &none         &none  &none  &none       &none  &none
&kp TAB           &kp SQT        &kp COMMA  &kp PERIOD  &kp P     &kp Y                                             &kp F         &kp G  &kp C  &kp R       &kp L  &kp SLASH
&kp LEFT_CONTROL  &kp A          &kp O      &kp E       &kp U     &kp I        &none             &none              &kp D         &kp H  &kp T  &kp N       &kp S  &kp MINUS
&kp LSHFT         &kp SEMICOLON  &kp Q      &kp J       &kp K     &kp X        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp B         &kp M  &kp W  &kp V       &kp Z  &lt 4 GRAVE
&kp LEFT_ALT      &mo 4          &kp LGUI   &kp ESCAPE  &kp BSPC  &to_english  &kp SPACE         &kp ENTER          &to_japanese  &none  &none  &kp DELETE  &mo 3  &mo 2
            >;
        };

        gact10_base {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &small  &to_va                  &to_ya  &to_ga  &to_ka  &to_ra  &to_pa  &trans
