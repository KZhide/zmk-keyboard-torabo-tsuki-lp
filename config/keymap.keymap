        escape_ime: escape_ime {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESCAPE &kp LANGUAGE_2 &to 23>;
            label = "ESCAPE_IME";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        mod_with_mo: new_macro {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo 23 &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 23 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "NEW_MACRO";
        };

        reset_press: reset_press {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "RESET_PRESS";
        };
    };

    behaviors {
        hold_and_tap_eng: hold_and_tap_eng {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_AND_TAP_ENG";
            bindings = <&kp>, <&to_english>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        hold_and_tap_ja: hold_and_tap_ja {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_AND_TAP_JA";
            bindings = <&kp>, <&to_japanese>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ht_vowel: ht_vowel {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_VOWEL";
            bindings = <&mo>, <&single_vowel>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

